<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.SalesController" styleClass="root-bg">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Label text="Борлуулалт" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" styleClass="muted"/>
            <Button text="Гарах" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="16" right="20" bottom="16" left="20"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="productCodeField" promptText="Барааны код" HBox.hgrow="ALWAYS" onAction="#handleAddToCart"/>
                <TextField fx:id="quantityField" promptText="Тоо" prefWidth="80" onAction="#handleAddToCart"/>
                <Button text="Нэмэх" onAction="#handleAddToCart" styleClass="primary"/>
            </HBox>

            <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colName" text="Бараа" prefWidth="360"/>
                    <TableColumn fx:id="colPrice" text="Үнэ" prefWidth="140"/>
                    <TableColumn fx:id="colQuantity" text="Тоо" prefWidth="100"/>
                    <TableColumn fx:id="colSubtotal" text="Дүн" prefWidth="160"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Сонгосныг хасах" onAction="#handleRemove"/>
                <Button text="Сагс цэвэрлэх" onAction="#handleClear"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalAmountLabel" text="Нийт: 0.00 ₮" styleClass="total"/>
                <Button text="Төлбөр хийх" onAction="#handleCheckout" styleClass="primary"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
